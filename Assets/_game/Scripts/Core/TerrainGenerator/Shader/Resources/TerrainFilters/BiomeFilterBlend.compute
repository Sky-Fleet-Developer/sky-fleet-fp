#pragma kernel CSBiomeFilterBlend

#include "Assets/_game/Scripts/Core/TerrainGenerator/Shader/BiomeDiagram.hlsl"

// Mixes the filtered heights of one biome into the result by the normalized biome weight. Bound by BiomeFilterBaker.
// Dispatch layout: id.xy = pixel, id.z = texture array layer.
// Pixel i lies at chunk uv (i + blend_pixel_offset) / blend_pixels_per_chunk, same as the heightmap.

RWTexture2DArray<float> blend_result;
Texture2DArray<float> blend_before; // copy of blend_result
Texture2DArray<float> blend_filtered;
StructuredBuffer<int3> blend_slot_coords; // per layer: chunk.xy, z = 1 when the biome has influence on the layer
int blend_biome;
int blend_resolution;
float blend_pixels_per_chunk;
float blend_pixel_offset;
float blend_chunk_size; // meters

[numthreads(8,8,1)]
void CSBiomeFilterBlend (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)blend_resolution || id.y >= (uint)blend_resolution)
    {
        return;
    }

    int3 slot = blend_slot_coords[id.z];
    if (slot.z == 0)
    {
        return;
    }

    float2 position = (slot.xy + (id.xy + blend_pixel_offset) / blend_pixels_per_chunk) * blend_chunk_size;
    uint2 range = biome_layer_ranges[id.z];

    // Weight of a biome is the max weight of its sites, normalized over the biomes, same as the debug view.
    // Sites come in blending order, so the sites of one biome are adjacent
    float total = 0;
    float target = 0;
    int current_biome = -1;
    float biome_weight = 0;
    for (uint i = 0; i <= range.y; i++)
    {
        BiomeSite site = (BiomeSite)0;
        bool weighted = false;
        if (i < range.y)
        {
            uint entry = biome_site_indices[range.x + i];
            weighted = (entry & BIOME_COMPETITOR_FLAG) == 0;
            if (weighted)
            {
                site = biome_sites[entry];
            }
        }

        // Flush the previous biome when the biome changes or the list ends
        if (i == range.y || (weighted && site.biome != current_biome))
        {
            total += biome_weight;
            if (current_biome == blend_biome)
            {
                target = biome_weight;
            }
            biome_weight = 0;
            current_biome = i < range.y ? site.biome : -1;
        }

        if (weighted)
        {
            biome_weight = max(biome_weight, BiomeSiteWeight(site, range, position));
        }
    }

    if (target <= 0)
    {
        return;
    }

    blend_result[id] = lerp(blend_before[id], blend_filtered[id], target / total);
}
