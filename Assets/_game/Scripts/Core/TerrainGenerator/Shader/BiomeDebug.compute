#pragma kernel CSBiomeDebug

#include "BiomeDiagram.hlsl"

// Dispatch layout: id.xy = pixel, id.z = texture array layer.
// Pixel i lies at chunk uv (i + biome_pixel_offset) / biome_pixels_per_chunk, same as the heightmap.

RWTexture2DArray<float4> biome_debug_destination;
StructuredBuffer<int3> biome_slot_coords; // per layer: chunk.xy, z = 1 when the layer is used
StructuredBuffer<float4> biome_colors;     // per biome
int biome_resolution;
float biome_pixels_per_chunk;
float biome_pixel_offset;
float biome_chunk_size; // meters

[numthreads(8,8,1)]
void CSBiomeDebug (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)biome_resolution || id.y >= (uint)biome_resolution)
    {
        return;
    }

    int3 slot = biome_slot_coords[id.z];
    if (slot.z == 0)
    {
        return;
    }

    float2 position = (slot.xy + (id.xy + biome_pixel_offset) / biome_pixels_per_chunk) * biome_chunk_size;
    uint2 range = biome_layer_ranges[id.z];

    // Normal biomes mixed by their normalized weights, then the layers on top, each by its own weight
    float3 color = 0;
    float total = 0;
    for (int p = 0; p < 2; p++) //look's like "pass" is a reserved name for hlsl
    {
        bool layers = p == 1;
        if (layers)
        {
            color = total > 0 ? color / total : float3(1, 1, 1);
        }

        // Sites come in blending order, so the sites of one biome are adjacent
        int current_biome = -1;
        float biome_weight = 0;
        for (uint i = 0; i <= range.y; i++)
        {
            BiomeSite site = (BiomeSite)0;
            bool weighted = false;
            if (i < range.y)
            {
                uint entry = biome_site_indices[range.x + i];
                if ((entry & BIOME_COMPETITOR_FLAG) == 0)
                {
                    site = biome_sites[entry];
                    weighted = BiomeIsLayer(site) == layers;
                }
            }

            // Flush the previous biome when the biome changes or the list ends
            if (i == range.y || (weighted && site.biome != current_biome))
            {
                if (current_biome >= 0 && biome_weight > 0)
                {
                    float3 biome_color = biome_colors[current_biome].rgb;
                    if (layers)
                    {
                        color = lerp(color, biome_color, biome_weight);
                    }
                    else
                    {
                        color += biome_color * biome_weight;
                        total += biome_weight;
                    }
                }
                current_biome = site.biome;
                biome_weight = 0;
            }

            if (weighted)
            {
                biome_weight = max(biome_weight, BiomeSiteWeight(site, range, position));
            }
        }
    }

    biome_debug_destination[id] = float4(color, 1);
}
