[numthreads(8,8,1)]
void CSAlignVerticesToHeightmap (uint2 id : SV_DispatchThreadID)
{
    if (id.x >= vertices_width_count || id.y >= vertices_width_count)
    {
        return;
    }
    int slot = map[chunk_coord_x * map_size + chunk_coord_y];
    if (slot.x == -1)
    {
        return;
    }
    
    packed_vertex vert = vertices[id.x * vertices_width_count + id.y];

    uint2 heightmap_space_id = id + uint2(heightmap_start_x, heightmap_start_y);
    vert.position.y = source_heightmap[uint3(heightmap_space_id, slot)];

    // 3. Берем выборки высоты для расчета градиента (смещение по X и Z)
    uint2 id_top_left = heightmap_space_id - uint2(1, 1);
    int x_dir = -1;
    if (id.x == 0)
    {
        x_dir = 1;
        id_top_left.x += 1;
    }
    int z_dir = -1;
    if (id.y == 0)
    {
        z_dir = 1;
        id_top_left.y += 1;
    }
    float height_x = source_heightmap[uint3(heightmap_space_id + int2(x_dir,0), slot)];//get_height_from_heightmap(id_top_left, float2(normal_dt * x_dir, 0.0));
    float height_z = source_heightmap[uint3(heightmap_space_id + int2(0, z_dir), slot)];

    // 4. Вычисляем частные производные (конечные разности)
    float dfdx = (height_x - vert.position.y) * normal_dx;
    float dfdz = (height_z - vert.position.y) * normal_dx;

    // 5. Формируем и нормализуем вектор нормали
    //float y_len = sqrt(1 - dfdx*dfdx - dfdz*dfdz);
    //float3 normal = float3(-dfdx * x_dir * chunk_size, y_len * chunk_height, -dfdz * z_dir * chunk_size);
    vert.normal = normalize(float3(dfdx, 1, dfdz));
    vert.position.y *= chunk_height;
    vertices[id.x * vertices_width_count + id.y] = vert;
}


[numthreads(4,4,4)]
void CSGetCollisionMap (uint3 id : SV_DispatchThreadID)
{
    if (id.x > collision_chunk_resolution || id.y > collision_chunk_resolution || id.z >= collision_chunks_count)
    {
        return;
    }
    int2 collision_chunk = collision_map_request[id.z];
    // World position of the vertex. chunk_size is the heightmap (data) chunk size
    float2 world_position = (collision_chunk * collision_chunk_resolution + (float2)id.xy + collision_offset) * collision_pixel_size;
    float2 heightmap_space = world_position / chunk_size;
    int2 heightmap_chunk = floor(heightmap_space);
    int2 map_local = heightmap_chunk - int2(chunk_coord_x, chunk_coord_y);

    // NaN marks a vertex without loaded heightmap data, so the CPU can retry the collision chunk later
    float height = asfloat(0x7fc00000);
    if (all(map_local >= 0) && all(map_local < map_size))
    {
        int slot = map[map_local.x * map_size + map_local.y];
        if (slot != -1)
        {
            float2 uv = heightmap_space - heightmap_chunk;
            float width, height_px, elements;
            source_heightmap.GetDimensions(width, height_px, elements);
            height = source_heightmap.SampleLevel(sampler_source_heightmap, float3(ChunkUvToTextureUv(uv, width, heightmap_shared_edges), slot), 0) * chunk_height;
        }
    }

    int res_plus_one = collision_chunk_resolution + 1;
    destination_collision_map[id.y * res_plus_one + id.x + (res_plus_one * res_plus_one * id.z)] = float3(id.x * collision_pixel_size, height, id.y * collision_pixel_size);
}
