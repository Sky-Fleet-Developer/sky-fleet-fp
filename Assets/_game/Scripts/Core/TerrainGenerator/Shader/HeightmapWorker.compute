#pragma kernel CSInsertRawHeightToTex
#pragma kernel CSInsertRawAlphaToTex
#pragma kernel CSAlignVerticesToHeightmap
#pragma kernel CSGetCollisionMap
#include "rectangle_affect_settings.hlsl"
#include "packed_vertex.hlsl"

Texture2D<float> source_heightmap;
RWTexture2D<float> destination_heightmap;
Texture2D source_alphamap;
RWTexture2D<float4> destination_alphamap;
StructuredBuffer<float> chunk_heightmap;
StructuredBuffer<uint> chunk_alphamap;
StructuredBuffer<int2> map;
//StructuredBuffer<rectangle_affect_settings> deformation_rectangle_settings;
//StructuredBuffer<float> deformation_heightmap;
RWStructuredBuffer<packed_vertex> vertices;

float chunk_size;
float chunk_height;
float heightmap_chunk_resolution;
uint vertices_count;
uint vertices_width_count;
float normal_dx;
float normal_dt;
int chunk_coord_x;
int chunk_coord_y;
int map_size;
uint heightmap_start_x;
uint heightmap_start_y;
bool flip_x_y_when_import_raw_heightmap;

//collision request data
RWStructuredBuffer<float3> destination_collision_map;
StructuredBuffer<int2> collision_map_request;
int collision_chunks_count;
int collision_chunk_resolution;
float heightmap_pixel_size;
float collision_pixel_size;
float2 collision_offset;
float heightmap_pixel_size_uv_space;
float slots_count_inv;
SamplerState sampler_source_heightmap;
//int collision_chunk_size;
//float collision_to_heightmap_mul;

