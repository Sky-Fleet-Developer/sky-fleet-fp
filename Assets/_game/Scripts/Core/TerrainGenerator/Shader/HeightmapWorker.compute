bool HalfToCoord(half value, out uint2 coord)
{
    uint rawBits = f32tof16((float)value);
    [branch] if (rawBits == 0)
    {
        coord = uint2(0,0);
        return false;
    }
    else
    {
        rawBits--;
        coord.x = rawBits & 0xFF;
        coord.y = (rawBits >> 8) & 0xFF;
        return true;
    }
}



// Raw chunk data upload. The source buffer holds chunk_source_resolution^2 values and is resampled to the
// destination resolution keeping the pixel layout: with shared edge pixels pixel i lies at i / (resolution - 1),
// otherwise it is the cell centered at (i + 0.5) / resolution.
int chunk_source_resolution;
bool chunk_source_shared_edges;

// Source pixel coordinate of a destination pixel, clamped to the source
float2 ChunkSourceCoordinate(uint2 id, float destination_resolution)
{
    float source = chunk_source_resolution;
    float2 coordinate = chunk_source_shared_edges
        ? id * (source - 1) / max(destination_resolution - 1, 1)
        : (id + 0.5) * source / destination_resolution - 0.5;
    return clamp(coordinate, 0, source - 1);
}

// Buffer index of source pixel (x, y). Row-major: rows go along y, like the files are read
// (RawReader heights[y, x], ReadPng pixels[x + y * width])
uint ChunkSourceIndex(int2 pixel)
{
    if (!flip_x_y_when_import_raw_heightmap)
    {
        pixel = pixel.yx;
    }
    return pixel.y * chunk_source_resolution + pixel.x;
}

[numthreads(8,8,1)]
void CSInsertRawHeightToTex (uint2 id : SV_DispatchThreadID)
{
    if (id.x >= heightmap_chunk_resolution || id.y >= heightmap_chunk_resolution)
    {
        return;
    }

    float2 coordinate = ChunkSourceCoordinate(id, heightmap_chunk_resolution);
    int2 p0 = (int2)floor(coordinate);
    int2 p1 = min(p0 + 1, chunk_source_resolution - 1);
    float2 interpolation = coordinate - p0;

    float bottom = lerp(chunk_heightmap[ChunkSourceIndex(p0)], chunk_heightmap[ChunkSourceIndex(int2(p1.x, p0.y))], interpolation.x);
    float top = lerp(chunk_heightmap[ChunkSourceIndex(int2(p0.x, p1.y))], chunk_heightmap[ChunkSourceIndex(p1)], interpolation.x);
    destination_heightmap[uint3(id, destination_slot)] = lerp(bottom, top, interpolation.y);
}

float4 unpack_uint(uint value)
{
    float r = (float)((value >>  0) & 0xFF) / 255.0f;
    float g = (float)((value >>  8) & 0xFF) / 255.0f;
    float b = (float)((value >> 16) & 0xFF) / 255.0f;
    float a = (float)((value >> 24) & 0xFF) / 255.0f;

    return float4(r, g, b, a);
}

float4 LoadChunkAlpha(int2 pixel)
{
    return unpack_uint(chunk_alphamap[ChunkSourceIndex(pixel)]);
}

[numthreads(8,8,1)]
void CSInsertRawAlphaToTex (uint2 id : SV_DispatchThreadID)
{
    if (id.x >= alphamap_chunk_resolution || id.y >= alphamap_chunk_resolution)
    {
        return;
    }

    float2 coordinate = ChunkSourceCoordinate(id, alphamap_chunk_resolution);
    int2 p0 = (int2)floor(coordinate);
    int2 p1 = min(p0 + 1, chunk_source_resolution - 1);
    float2 interpolation = coordinate - p0;

    float4 bottom = lerp(LoadChunkAlpha(p0), LoadChunkAlpha(int2(p1.x, p0.y)), interpolation.x);
    float4 top = lerp(LoadChunkAlpha(int2(p0.x, p1.y)), LoadChunkAlpha(p1), interpolation.x);
    destination_alphamap[uint3(id, destination_slot)] = lerp(bottom, top, interpolation.y);
}


