// Grass placement, every frame on the GPU (Runtime.Grass.GrassRenderer). Tiles, candidates, layers and areas are
// shared with the other scattered details (Visual/Scatter/ScatterPlacement.hlsl); here the plants are built:
// size, colors, lean and the push of the pushers.

#pragma kernel Reset
#pragma kernel CullTiles
#pragma kernel Place
#pragma kernel ClampArgs

#pragma multi_compile_local _ TERRAIN_GEOMORPH

#include "Assets/_game/Visual/Scatter/ScatterPlacement.hlsl"
#include "GrassCommon.hlsl"

StructuredBuffer<GrassLayer> grass_layers; // at the indices of scatter_layers
float grass_max_widening;
StructuredBuffer<GrassPusher> grass_pushers;
uint grass_pusher_count;

RWStructuredBuffer<GrassBlade> scatter_instances;

// Lean away from the pushers, in plant heights: strongest where the center of a pusher is nearest to the plant
float2 PushAt(float3 root, float height, float facing)
{
    float2 push = 0;
    for (uint i = 0; i < grass_pusher_count; i++)
    {
        GrassPusher pusher = grass_pushers[i];
        float3 nearest = float3(root.x, clamp(pusher.center.y, root.y, root.y + height), root.z);
        float strength = saturate(1 - distance(pusher.center, nearest) / max(pusher.radius, 1e-3)) * pusher.strength;
        float2 away = root.xz - pusher.center.xz;
        float length_away = length(away);
        // Right under the center the plant falls its own way
        float2 direction = length_away > 1e-3 ? away / length_away : float2(sin(facing), cos(facing));
        push += direction * strength;
    }
    float length_push = length(push);
    return length_push > 2 ? push * (2 / length_push) : push;
}

[numthreads(SCATTER_PLACE_THREADS, 1, 1)]
void Place(uint3 group : SV_GroupID, uint thread : SV_GroupIndex)
{
    ScatterTile t = ScatterLoadTile(group.x);
    for (uint i = thread; i < t.count; i += SCATTER_PLACE_THREADS)
    {
        ScatterCandidate c;
        if (!ScatterTryCandidate(t, i, c))
        {
            continue;
        }

        GrassLayer layer = grass_layers[c.layer];
        float height = lerp(layer.height.x, layer.height.y, ScatterRandom(t.tile, i, 3)) * c.scale;
        if (!ScatterSphereInFrustum(c.root + float3(0, height * 0.5, 0), height) && !ScatterKeepOutsideView(c))
        {
            continue;
        }

        float terrain_height;
        float3 normal;
        SampleHeightAndNormal(c.world_flat, terrain_height, normal);

        // Far plants are fewer and wider, so the grass keeps covering the ground
        float widening = min(grass_max_widening, rsqrt(ScatterDensityFactor(c.distance)));
        float shade = 1 + (ScatterRandom(t.tile, i, 4) - 0.5) * 2 * layer.color_variation;
        float3 tint = float3(1 + (ScatterRandom(t.tile, i, 5) - 0.5) * layer.color_variation, 1, 1);

        GrassBlade blade;
        blade.position = c.root;
        blade.facing = ScatterRandom(t.tile, i, 6) * 6.28318;
        blade.size = float2(layer.width * widening, height);
        blade.bend = layer.bend * (0.5 + ScatterRandom(t.tile, i, 7));
        blade.base_color = PackGrassColor(layer.base_color * shade * tint);
        blade.tip_color = PackGrassColor(layer.tip_color * shade * tint);
        blade.normal_xz = normal.xz;
        blade.push = PushAt(c.root, height, blade.facing);
        blade.variation = PackGrassVariation(c.layer, shade, tint.x);

        uint slot;
        if (ScatterAllocate(layer.shape * 2 + (c.near ? 0 : 1), slot))
        {
            scatter_instances[slot] = blade;
        }
    }
}
